# Copy to .env if you need workspace-specific overrides. Never commit .env.
# Launch uses LM Studio over local HTTP by default and does not require an API key.

# Optional: Greenhouse email verification code retrieval over IMAP.
# For Gmail, create an App Password first, then point FMJ_EMAIL_OTP_PASSWORD_ENV
# at the env var that stores it.
# FMJ_EMAIL_OTP_ENABLED=1
# FMJ_EMAIL_OTP_HOST=imap.gmail.com
# FMJ_EMAIL_OTP_PORT=993
# FMJ_EMAIL_OTP_USERNAME=you@example.com
# FMJ_EMAIL_OTP_PASSWORD_ENV=FMJ_GMAIL_APP_PASSWORD
# FMJ_GMAIL_APP_PASSWORD=replace_with_your_app_password
# FMJ_EMAIL_OTP_FOLDER=INBOX
# FMJ_EMAIL_OTP_FROM_CONTAINS=greenhouse
# FMJ_EMAIL_OTP_TIMEOUT_SECONDS=90
# FMJ_EMAIL_OTP_POLL_SECONDS=3
# FMJ_EMAIL_OTP_MAX_MESSAGES=20
