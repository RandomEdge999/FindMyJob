# Copy this file to .env and fill in the values you need. .env is gitignored.
# Launch uses LM Studio over local HTTP by default and does not require an API key.
# Everything below is optional unless your workflow needs it.

# --- Web server bind (defaults shown) -----------------------------------------
# FMJ_HOST=127.0.0.1
# FMJ_PORT=8765
# FMJ_OPEN_BROWSER=1

# --- Optional cloud LLM keys --------------------------------------------------
# Used by the screening / Q&A model roles when you configure remote_http in
# Settings > Models. The drafting (resume + cover letter) role stays pinned to
# LM Studio by design and does not consume these keys.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- Optional: Greenhouse email verification code retrieval over IMAP ---------
# For Gmail, create an App Password at https://myaccount.google.com/apppasswords
# and put the password in FMJ_GMAIL_APP_PASSWORD below. Never share this file
# after filling it in.
# FMJ_EMAIL_OTP_ENABLED=1
# FMJ_EMAIL_OTP_HOST=imap.gmail.com
# FMJ_EMAIL_OTP_PORT=993
# FMJ_EMAIL_OTP_USERNAME=you@example.com
# FMJ_EMAIL_OTP_PASSWORD_ENV=FMJ_GMAIL_APP_PASSWORD
# FMJ_GMAIL_APP_PASSWORD=replace_with_your_app_password
# FMJ_EMAIL_OTP_FOLDER=INBOX
# FMJ_EMAIL_OTP_FROM_CONTAINS=greenhouse
# FMJ_EMAIL_OTP_TIMEOUT_SECONDS=90
# FMJ_EMAIL_OTP_POLL_SECONDS=3
# FMJ_EMAIL_OTP_MAX_MESSAGES=20

